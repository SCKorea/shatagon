    <Compile Include="../../Localization/LocalizationComposer.cs" Link="LocalizationComposer.cs" />
    <Compile Include="../../Localization/FeatureSelection.cs" Link="FeatureSelection.cs" />
    <Compile Include="../../Localization/LocalizationReleaseClient.cs" Link="LocalizationReleaseClient.cs" />
    <Compile Include="../../Localization/LegacyReleaseTags.cs" Link="LegacyReleaseTags.cs" />
  </ItemGroup>
</Project>
