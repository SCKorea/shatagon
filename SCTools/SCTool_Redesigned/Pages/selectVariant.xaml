<Page x:Class="SCTool_Redesigned.Pages.selectVariant"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lang="clr-namespace:SCTool_Redesigned.Properties"
      Title="selectVariant">
    <Grid>
        <Label Content="04" FontWeight="Bold" HorizontalAlignment="Left" Margin="50,40,0,0" VerticalAlignment="Top" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource GmarketSansB}" FontSize="36"/>
        <Label Content="{x:Static lang:Resources.UI_Desc_SelectLocalizationVariant}" HorizontalAlignment="Left" Margin="50,90,0,0" VerticalAlignment="Top" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource SCDream5}" FontSize="18"/>
        <ComboBox x:Name="VariantSelectListBox" HorizontalAlignment="Left" Margin="50,150,0,0" VerticalAlignment="Top" Width="650" Height="35" FontFamily="{StaticResource SCDream5}" FontSize="16" SelectionChanged="VariantSelectListBox_SelectionChanged"/>
        <TextBlock x:Name="LegacyNotice" Text="{x:Static lang:Resources.UI_Desc_LegacyVariant}" HorizontalAlignment="Left" Margin="50,150,50,0" VerticalAlignment="Top" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource SCDream5}" FontSize="17" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Page>
